{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: build Matrix Resizer",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}/MatrixResizer/main.cpp",
                "${workspaceFolder}/MatrixResizer/Matrix.cpp",
                "-o",
                "${workspaceFolder}/matrix-resizer"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build Matrix Resizer for Linux debugging"
        }
    ]
}